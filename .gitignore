# ==========================================
# Antara Multilingual Mental Health Journal
# .gitignore configuration
# ==========================================

# 1. Databases & Database Folders
db/
*/db/
**/db/
*.db
*.sqlite
*.sqlite3
journal.db
backend/journal.db

# 2. Node Modules & Frontend Dependencies
node_modules/
*/node_modules/
**/node_modules/

# 3. Environment & Secret Configs
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
**/.env
**/.env.*
!*.env.example
!.env.example

# 4. Python Virtual Environments & Bytecode
venv/
.venv/
*/venv/
*/.venv/
**/venv/
**/__pycache__/
__pycache__/
*.py[cod]
*.class
*.pyc
.pytest_cache/
*/.pytest_cache/

# 5. Large ML Model Weights (>100MB GitHub limit)
*.pt
*.pth
*.bin
*.safetensors
*.onnx
ml/models/emotion_model/model.pt
ml/models/*.pt
ml/checkpoints/
checkpoints/

# 6. Next.js & Frontend Build Outputs
.next/
*/.next/
**/dist/
**/build/
out/
.turbo/

# 7. Logs & OS Temp Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
